{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "crm": {
      "root": "apps/crm",
      "framework": "nextjs"
    },
    "web": {
      "root": "apps/web",
      "framework": "vite"
    }
  },
  "rewrites": [
    { "source": "/crm/(.*)", "destination": { "service": "crm" } },
    { "source": "/api/(.*)",  "destination": { "service": "crm" } },
    { "source": "/(.*)",      "destination": { "service": "web" } }
  ]
}
