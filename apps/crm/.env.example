# ============================================================
# Palladio CRM — Environment Variables
# Kopiraj u .env.local za lokalni dev
# Na Vercel dodaj ove varijable u Project Settings > Environment Variables
# ============================================================

# Vercel Postgres (automatski se injektira kad povežeš Vercel Postgres u dashboardu)
# Za lokalni dev: kopiraj iz Vercel dashboarda > Storage > .env.local
POSTGRES_URL=postgres://user:password@host.neon.tech/neondb?sslmode=require
POSTGRES_PRISMA_URL=postgres://user:password@host.neon.tech/neondb?sslmode=require&pgbouncer=true
POSTGRES_URL_NON_POOLING=postgres://user:password@host.neon.tech/neondb?sslmode=require

# Stripe (server-side only — NIKAD ne izlažuj u frontend!)
STRIPE_SECRET_KEY=sk_live_51Nk3lQJkR9uDW4po...

# HTTP Basic Auth za CRM (zaštita sučelja)
APP_USERNAME=admin
APP_PASSWORD=changeme123

# WordPress backend URL (bez trailing slash)
NEXT_PUBLIC_WP_URL=https://palladio.hr

# SMTP (opcionalno — za slanje emaila iz CRM-a)
PCRM_SMTP_HOST=mail.palladio.hr
PCRM_SMTP_PORT=465
PCRM_SMTP_USER=info@palladio.hr
PCRM_SMTP_PASS=your_smtp_password

# Stripe Publishable Key (sigurno za browser — koristi se na /plati/[token] stranici)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_51Nk3lQJkR9uDW4pos9CXQdNkBrsiGdUWcqEpgNGUvgFWDjsTafiGjI6ZEfyK194CGLzwlVAx7OSnTxc9LNvbwYLO00Zp3hbXSo

# CRM javni URL (za generiranje payment link URL-a u sučelju)
NEXT_PUBLIC_CRM_URL=https://crm.palladio.hr
