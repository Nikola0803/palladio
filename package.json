{
  "name": "palladio-monorepo",
  "private": true,
  "workspaces": [
    "apps/crm",
    "apps/web"
  ],
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "scripts": {
    "dev:crm": "cd apps/crm && npm run dev",
    "dev:web": "cd apps/web && npm run dev",
    "build:crm": "cd apps/crm && npm run build",
    "build:web": "cd apps/web && npm run build"
  }
}
